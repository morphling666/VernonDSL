              "renderable blendable filterable storage resolvable multisample copyable", 0x822B, 0x8227, 0x1401,
              VK_FORMAT_R8G8_UNORM, DXGI_FORMAT_R8G8_UNORM, MTLPixelFormatRG8Unorm, Rg8)
